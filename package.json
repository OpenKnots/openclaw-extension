{
  "name": "openclaw-extension",
  "displayName": "OpenClaw Extension",
  "description": "Status bar connector for the OpenClaw CLI",
  "version": "0.1.0",
  "publisher": "openknot",
  "author": {
    "name": "Val Alexander",
    "email": "val@openknot.ai"
  },
  "license": "MIT",
  "homepage": "https://github.com/openknots/openclaw-extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/openknots/openclaw-extension.git"
  },
  "icon": "assets/images/image.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "cli",
    "openclaw",
    "openknot",
    "clawdbot",
    "moltbot",
    "vscode"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openclaw.connect",
        "title": "OpenClaw: Connect"
      },
      {
        "command": "openclaw.setup",
        "title": "OpenClaw: Setup"
      },
      {
        "command": "openclaw.modelSetup",
        "title": "OpenClaw: Model Setup Wizard"
      },
      {
        "command": "openclaw.harden",
        "title": "OpenClaw: Harden"
      },
      {
        "command": "openclaw.hardening.showAccessSummary",
        "title": "OpenClaw: Hardening Access Summary"
      },
      {
        "command": "openclaw.chat.open",
        "title": "OpenClaw: Open Chat"
      },
      {
        "command": "openclaw.chat.popOut",
        "title": "OpenClaw: Pop Out Chat"
      },
      {
        "command": "openclaw.chat.newSession",
        "title": "OpenClaw: New Chat Session"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openclaw",
          "title": "OpenClaw",
          "icon": "assets/icons/openclaw.svg"
        }
      ]
    },
    "views": {
      "openclaw": [
        {
          "id": "openclaw.chat",
          "type": "webview",
          "name": "Chat"
        },
        {
          "id": "openclaw.overview",
          "name": "Overview"
        }
      ]
    },
    "configuration": {
      "title": "OpenClaw",
      "properties": {
        "openclaw.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "Automatically connect to OpenClaw on startup"
        },
        "openclaw.command": {
          "type": "string",
          "default": "openclaw status",
          "description": "Command to run when connecting (e.g. 'openclaw status' or 'wsl openclaw status')"
        },
        "openclaw.hardening.mode": {
          "type": "string",
          "enum": [
            "full",
            "audit",
            "auditFix"
          ],
          "default": "full",
          "description": "Hardening workflow to run: audit only, audit + fix, or full (audit, fix, deep)"
        },
        "openclaw.hardening.command": {
          "type": "string",
          "default": "openclaw",
          "description": "Command prefix to run OpenClaw hardening (e.g. 'openclaw' or 'wsl openclaw')"
        },
        "openclaw.chat.agent": {
          "type": "string",
          "default": "codex",
          "description": "Agent to use for chat sessions (e.g. 'codex', 'gemini', 'opencode')"
        },
        "openclaw.chat.permissions": {
          "type": "string",
          "enum": [
            "approve-reads",
            "approve-all",
            "deny-all"
          ],
          "default": "approve-reads",
          "description": "Permission mode for chat agent: approve-reads (default), approve-all, or deny-all"
        },
        "openclaw.chat.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "codex",
            "gemini",
            "opencode",
            "claude",
            "gpt-4o",
            "ollama"
          ],
          "description": "Available models shown in the chat model picker"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vitest run",
    "installLocal": "scripts/install-local.sh",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish -p $OVSX_TOKEN",
    "publish:all": "scripts/publish-all.sh"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/vscode": "~1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@create-markdown/core": "^2.0.0",
    "@create-markdown/preview": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
